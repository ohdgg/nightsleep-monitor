// Resource ids must match the constants in src/tray.rs (ICON_NORMAL / ICON_DIM).
#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

1 ICON "resources/icon.ico"
2 ICON "resources/icon-dim.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "resources/nightsleep.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEOS 0x4
FILETYPE 0x1
{
    BLOCK "StringFileInfo"
    {
        BLOCK "040904B0"
        {
            VALUE "FileDescription", "NightSleep - deep screen dimming"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "nightsleep"
            VALUE "OriginalFilename", "nightsleep.exe"
            VALUE "ProductName", "NightSleep"
            VALUE "ProductVersion", "1.0.0"
            VALUE "LegalCopyright", "MIT OR Apache-2.0"
        }
    }
    BLOCK "VarFileInfo"
    {
        VALUE "Translation", 0x409, 1200
    }
}
